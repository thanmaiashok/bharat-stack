{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/thanmaiashok/bharat-stack/schemas/einvoice-1.1.schema.json",
  "title": "GST e-invoice (IRN) request, INV-01 version 1.1",
  "description": "Rebuilt from two public copies of the NIC INV-01 v1.1 schema workbook (official portal unreachable from the build environment). Field lengths, ranges and patterns match those copies. Replace with the official file when available and set x-verification to official.",
  "x-source": "https://raw.githubusercontent.com/in-co-sandbox/in-co-sandbox-docs/HEAD/data/gst/schema/request/e-invoice/generate_e_invoice.json",
  "x-last-verified": "2026-11-04",
  "x-verification": "secondary",
  "type": "object",
  "additionalProperties": false,
  "required": ["Version", "TranDtls", "DocDtls", "SellerDtls", "BuyerDtls", "ItemList", "ValDtls"],
  "properties": {
    "Version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6
    },
    "TranDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TaxSch", "SupTyp"],
      "properties": {
        "TaxSch": {
          "type": "string",
          "enum": ["GST"]
        },
        "SupTyp": {
          "type": "string",
          "enum": ["B2B", "SEZWP", "SEZWOP", "EXPWP", "EXPWOP", "DEXP"]
        },
        "RegRev": {
          "type": "string",
          "enum": ["Y", "N"]
        },
        "EcmGstin": {
          "type": "string",
          "minLength": 15,
          "maxLength": 15,
          "pattern": "^([0-9]{2}[0-9A-Z]{13})$"
        },
        "IgstOnIntra": {
          "type": "string",
          "enum": ["Y", "N"]
        }
      }
    },
    "DocDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Typ", "No", "Dt"],
      "properties": {
        "Typ": {
          "type": "string",
          "enum": ["INV", "CRN", "DBN"]
        },
        "No": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^([A-Za-z1-9][A-Za-z0-9/-]{0,15})$"
        },
        "Dt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-3][0-9]/[0-1][0-9]/[2][0][1-2][0-9]$"
        }
      }
    },
    "SellerDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Gstin", "LglNm", "Addr1", "Loc", "Pin", "Stcd"],
      "properties": {
        "Gstin": {
          "type": "string",
          "minLength": 15,
          "maxLength": 15,
          "pattern": "^([0-9]{2}[0-9A-Z]{13})$"
        },
        "LglNm": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[^\"]*$"
        },
        "TrdNm": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[^\"]*$"
        },
        "Addr1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\"]*$"
        },
        "Addr2": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[^\"]*$"
        },
        "Loc": {
          "type": "string",
          "minLength": 3,
          "maxLength": 50,
          "pattern": "^[^\"]*$"
        },
        "Pin": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 999999
        },
        "Stcd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "pattern": "^(?!0+$)([0-9]{1,2})$"
        },
        "Ph": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^([0-9]{6,12})$"
        },
        "Em": {
          "type": "string",
          "minLength": 6,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9+_.-]+@[a-zA-Z0-9.-]+$"
        }
      }
    },
    "BuyerDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Gstin", "LglNm", "Pos", "Addr1", "Loc", "Stcd"],
      "properties": {
        "Gstin": {
          "type": "string",
          "minLength": 3,
          "maxLength": 15,
          "pattern": "^(([0-9]{2}[0-9A-Z]{13})|URP)$"
        },
        "Pos": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "pattern": "^(?!0+$)([0-9]{1,2})$"
        },
        "LglNm": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[^\"]*$"
        },
        "TrdNm": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[^\"]*$"
        },
        "Addr1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\"]*$"
        },
        "Addr2": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[^\"]*$"
        },
        "Loc": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[^\"]*$"
        },
        "Pin": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 999999
        },
        "Stcd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "pattern": "^(?!0+$)([0-9]{1,2})$"
        },
        "Ph": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^([0-9]{6,12})$"
        },
        "Em": {
          "type": "string",
          "minLength": 6,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9+_.-]+@[a-zA-Z0-9.-]+$"
        }
      }
    },
    "ItemList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "SlNo",
          "IsServc",
          "HsnCd",
          "UnitPrice",
          "TotAmt",
          "AssAmt",
          "GstRt",
          "TotItemVal"
        ],
        "properties": {
          "SlNo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6,
            "pattern": "^([0-9]{1,6})$"
          },
          "PrdDesc": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "pattern": "^[^\"]*$"
          },
          "IsServc": {
            "type": "string",
            "enum": ["Y", "N"]
          },
          "HsnCd": {
            "type": "string",
            "minLength": 4,
            "maxLength": 8,
            "pattern": "^(?!0+$)([0-9]{4}|[0-9]{6}|[0-9]{8})$"
          },
          "Barcde": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          },
          "Qty": {
            "type": "number",
            "minimum": 0,
            "maximum": 9999999999.999
          },
          "FreeQty": {
            "type": "number",
            "minimum": 0,
            "maximum": 9999999999.999
          },
          "Unit": {
            "type": "string",
            "minLength": 3,
            "maxLength": 8,
            "pattern": "^([A-Z|a-z]{3,8})$"
          },
          "UnitPrice": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.999
          },
          "TotAmt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "Discount": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "PreTaxVal": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "AssAmt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "GstRt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999.999
          },
          "IgstAmt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "CgstAmt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "SgstAmt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "CesRt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999.999
          },
          "CesAmt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "CesNonAdvlAmt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "StateCesRt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999.999
          },
          "StateCesAmt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "StateCesNonAdvlAmt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "OthChrg": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          },
          "TotItemVal": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999999999.99
          }
        }
      }
    },
    "ValDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AssVal", "TotInvVal"],
      "properties": {
        "AssVal": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        },
        "CgstVal": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        },
        "SgstVal": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        },
        "IgstVal": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        },
        "CesVal": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        },
        "StCesVal": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        },
        "Discount": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        },
        "OthChrg": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        },
        "RndOffAmt": {
          "type": "number",
          "minimum": -99.99,
          "maximum": 99.99
        },
        "TotInvVal": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        },
        "TotInvValFc": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999999999999.98
        }
      }
    },
    "PayDtls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Nm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "AccDet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18
        },
        "Mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18
        },
        "FinInsBr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11
        },
        "PayTerm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "PayInstr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "CrTrn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "DirDr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "CrDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "PaidAmt": {
          "type": "number",
          "minimum": 0,
          "maximum": 999999999999.99
        },
        "PaymtDue": {
          "type": "number",
          "minimum": 0,
          "maximum": 999999999999.99
        }
      }
    },
    "ExpDtls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ShipBNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "ShipBDt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-3][0-9]/[0-1][0-9]/[2][0][1-2][0-9]$"
        },
        "Port": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10,
          "pattern": "^[0-9|A-Z|a-z]{2,10}$"
        },
        "RefClm": {
          "type": "string",
          "enum": ["Y", "N"]
        },
        "ForCur": {
          "type": "string",
          "minLength": 3,
          "maxLength": 16
        },
        "CntCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "pattern": "^([A-Z]{2})$"
        },
        "ExpDuty": {
          "type": "number",
          "minimum": 0,
          "maximum": 999999999999.99
        }
      }
    }
  },
  "x-secondary-source": "https://raw.githubusercontent.com/aiinicai/AICA-Level-2-Projects/HEAD/AICA-L2B88-Capstone%20Project_PraNam_EInvoice_Converter%20by%20CA%20Pratik%20Trivedi/pec/data/einvoice_schema_v1_1.json"
}
